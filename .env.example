# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), or the legacy anon key. Safe to expose.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), or the legacy service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
